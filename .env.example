# Rakshak — environment. Copy to .env and fill in. See IMPLEMENTATION.md §0.4 and PRD.md.
# Never commit .env.

# --- Phase 0: accounts ---
TINKER_API_KEY=            # check Tinker docs for the exact variable name the SDK reads
HF_TOKEN=                  # Hugging Face read token

# --- Phase 1: local models (decided in notes/phase1.md) ---
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_AUDIO_URL=           # e.g. http://127.0.0.1:8082/v1 if Gemma audio works in llama-server; else blank
ASR_FALLBACK=mlx-whisper   # gemma | mlx-whisper
OCR_FALLBACK=tesseract     # gemma | tesseract

# --- Phase 4: training ---
DETECTOR_BASE=Qwen/Qwen3.5-4B

# --- Phase 5: detector + hub ---
DETECTOR_URL=http://127.0.0.1:8081/v1
DETECTOR_GGUF=models/rakshak-detector-v1-q4km.gguf
DETECTOR_VERSION=rakshak-detector-v1-q4km
T_HIGH=                    # written by eval/calibrate.py on dev
T_LOW=
HUB_HOST=127.0.0.1         # never 0.0.0.0
HUB_PORT=8000
DB_PATH=var/rakshak.db
KEEP_MEDIA=false

# --- Phase 6: people, phone, alerts, tracing ---
PARENTS_FILE=config/parents.json   # mom (android) + dad (ios); see PRD §2
DEFAULT_LANG=en            # en | hi (per-parent setting lives in parents.json)
SON_NAME=Muaaz
PUBLIC_BASE_URL=           # https://<mac-name>.<tailnet>.ts.net from `tailscale serve`
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                # unguessable: rakshak-<random>
SENTRY_DSN=
SENTRY_ENV=weekend

# --- Phase 7: privacy test ---
RAKSHAK_CANARY=CANARY-change-me

# --- Phase 8 (optional): demo narration only, never parent data ---
ELEVENLABS_API_KEY=
